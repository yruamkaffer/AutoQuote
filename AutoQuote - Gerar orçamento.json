    {
      "parameters": {
        "content": "\n\n\n\n\n\n\n## Captura os dados da planilha de orçamento",
        "height": 224,
        "width": 432,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -48,
        -48
      ],
      "typeVersion": 1,
      "id": "11ca0ba0-fe74-493f-969b-b7b20bd3b274",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "// ==========================================================\n// AUTOQUOTE — CÁLCULO DOS ORÇAMENTOS\n// Modo: Run Once for All Items\n// ==========================================================\n\n// Solicitações vindas do node que lê Respostas_Formulario\nconst pedidos = $('Nova solicitação')\n\t.all()\n\t.map(item => item.json);\n\n// Os 47 itens que entram neste Code são as regras da Tabela_Precos\nconst regras = $input\n\t.all()\n\t.map(item => item.json);\n\n// ----------------------------------------------------------\n// FUNÇÕES AUXILIARES\n// ----------------------------------------------------------\n\nfunction texto(valor) {\n\treturn String(valor ?? '').trim();\n}\n\nfunction normalizar(valor) {\n\treturn texto(valor)\n\t\t.normalize('NFD')\n\t\t.replace(/[\\u0300-\\u036f]/g, '')\n\t\t.toLowerCase();\n}\n\nfunction numero(valor, padrao = 0) {\n\tif (typeof valor === 'number') {\n\t\treturn Number.isFinite(valor) ? valor : padrao;\n\t}\n\n\tlet valorLimpo = String(valor ?? '').trim();\n\n\tif (!valorLimpo) {\n\t\treturn padrao;\n\t}\n\n\t// Remove R$, espaços, %, letras e outros caracteres\n\tvalorLimpo = valorLimpo.replace(/[^\\d,.\\-]/g, '');\n\n\tconst possuiVirgula = valorLimpo.includes(',');\n\tconst possuiPonto = valorLimpo.includes('.');\n\n\t// Exemplo: 1.234,56\n\tif (possuiVirgula && possuiPonto) {\n\t\tif (\n\t\t\tvalorLimpo.lastIndexOf(',') >\n\t\t\tvalorLimpo.lastIndexOf('.')\n\t\t) {\n\t\t\tvalorLimpo = valorLimpo\n\t\t\t\t.replace(/\\./g, '')\n\t\t\t\t.replace(',', '.');\n\t\t} else {\n\t\t\t// Exemplo: 1,234.56\n\t\t\tvalorLimpo = valorLimpo.replace(/,/g, '');\n\t\t}\n\t} else if (possuiVirgula) {\n\t\t// Exemplo: 1,90\n\t\tvalorLimpo = valorLimpo.replace(',', '.');\n\t}\n\n\tconst convertido = Number(valorLimpo);\n\n\treturn Number.isFinite(convertido)\n\t\t? convertido\n\t\t: padrao;\n}\n\nfunction percentual(valor, padrao = 0) {\n\tconst textoOriginal = String(valor ?? '').trim();\n\tconst valorConvertido = numero(valor, padrao);\n\n\t// \"15%\" vira 0.15\n\tif (textoOriginal.includes('%')) {\n\t\treturn valorConvertido / 100;\n\t}\n\n\t// \"0,15\" continua 0.15\n\treturn valorConvertido;\n}\n\nfunction ativo(valor) {\n\tif (valor === true || valor === 1) {\n\t\treturn true;\n\t}\n\n\treturn ['true', 'sim', 'yes', '1'].includes(normalizar(valor));\n}\n\nfunction arredondar(valor) {\n\treturn Math.round((valor + Number.EPSILON) * 100) / 100;\n}\n\nfunction calcularArea(dimensoes) {\n\tconst numeros = texto(dimensoes)\n\t\t.replace(/,/g, '.')\n\t\t.match(/\\d+(?:\\.\\d+)?/g);\n\n\tif (!numeros || numeros.length < 2) {\n\t\treturn null;\n\t}\n\n\tconst largura = Number(numeros[0]);\n\tconst altura = Number(numeros[1]);\n\n\tif (\n\t\t!Number.isFinite(largura) ||\n\t\t!Number.isFinite(altura) ||\n\t\tlargura <= 0 ||\n\t\taltura <= 0\n\t) {\n\t\treturn null;\n\t}\n\n\treturn largura * altura;\n}\n\nfunction dataFormatoISO(data) {\n\treturn data.toISOString().slice(0, 10);\n}\n\nfunction resultadoRevisao(pedido, motivos) {\n\treturn {\n\t\tjson: {\n\t\t\tid_orcamento: texto(pedido.id_solicitacao)\n\t\t\t\t.replace(/^AQ-/i, 'ORC-'),\n\n\t\t\tid_solicitacao: texto(pedido.id_solicitacao),\n\t\t\tdata_processamento: new Date().toISOString(),\n\t\t\tnome_empresa: texto(pedido.nome_empresa),\n\t\t\ttipo_embalagem: texto(pedido.tipo_embalagem),\n\t\t\tmaterial: texto(pedido.material),\n\t\t\tdimensoes: texto(pedido.dimensoes),\n\t\t\tquantidade: numero(pedido.quantidade),\n\t\t\tnumero_cores: numero(pedido.numero_cores),\n\t\t\tprazo_dias: numero(pedido.prazo_dias),\n\n\t\t\tcodigo_regra_preco: '',\n\t\t\tpreco_base_unitario: '',\n\t\t\tadicional_cores_unitario: '',\n\t\t\tadicional_acabamento_unitario: '',\n\t\t\tsetup: '',\n\t\t\tpercentual_urgencia: '',\n\t\t\tsubtotal: '',\n\t\t\tvalor_total: '',\n\n\t\t\tstatus: 'REVISAO',\n\t\t\tmotivo_revisao: motivos.join('; '),\n\t\t\tvalidade_ate: '',\n\t\t\tlink_pdf: '',\n\t\t},\n\t};\n}\n\n// ----------------------------------------------------------\n// SEPARAÇÃO DAS REGRAS\n// ----------------------------------------------------------\n\nconst regrasAtivas = regras.filter(regra => {\n\tconst valorAtivo = normalizar(regra.ativo);\n\n\t// Se a coluna ativo não existir ou estiver vazia,\n\t// considera a regra como ativa.\n\tif (valorAtivo === '') {\n\t\treturn true;\n\t}\n\n\t// Somente valores explicitamente negativos desativam a regra.\n\treturn ![\n\t\t'false',\n\t\t'falso',\n\t\t'nao',\n\t\t'não',\n\t\t'0',\n\t\t'inativo',\n\t].includes(valorAtivo);\n});\n\nconst regrasPrecoBase = regrasAtivas.filter(\n\tregra => normalizar(regra.categoria) === 'preco_base'\n);\n\nconst regrasAcabamento = regrasAtivas.filter(\n\tregra => normalizar(regra.categoria) === 'acabamento'\n);\n\nconst regrasUrgencia = regrasAtivas\n\t.filter(regra => normalizar(regra.categoria) === 'urgencia')\n\t.sort(\n\t\t(a, b) =>\n\t\t\tnumero(a.prazo_max_dias, 999999) -\n\t\t\tnumero(b.prazo_max_dias, 999999)\n\t);\n\nconst parametros = regrasAtivas.filter(\n\tregra => normalizar(regra.categoria) === 'parametro'\n);\n\nfunction buscarParametro(nome, padrao) {\n\tconst regra = parametros.find(\n\t\titem => normalizar(item.parametro) === normalizar(nome)\n\t);\n\n\treturn regra ? regra.valor_parametro : padrao;\n}\n\nconst quantidadeMinima = numero(\n\tbuscarParametro('quantidade_minima', 500),\n\t500\n);\n\nconst validadeDias = numero(\n\tbuscarParametro('validade_dias', 10),\n\t10\n);\n\n// ----------------------------------------------------------\n// PROCESSAMENTO DOS PEDIDOS\n// ----------------------------------------------------------\n\nreturn pedidos.map(pedido => {\n\tconst idSolicitacao = texto(pedido.id_solicitacao);\n\tconst nomeEmpresa = texto(pedido.nome_empresa);\n\tconst tipoEmbalagem = texto(pedido.tipo_embalagem);\n\tconst material = texto(pedido.material);\n\tconst dimensoes = texto(pedido.dimensoes);\n\tconst quantidade = numero(pedido.quantidade);\n\tconst numeroCores = numero(pedido.numero_cores);\n\tconst prazoDias = numero(pedido.prazo_dias);\n\tconst observacoes = texto(pedido.observacoes);\n\n\tconst motivos = [];\n\n\tif (!idSolicitacao) {\n\t\tmotivos.push('ID da solicitação ausente');\n\t}\n\n\tif (!nomeEmpresa) {\n\t\tmotivos.push('Nome da empresa ausente');\n\t}\n\n\tif (!tipoEmbalagem) {\n\t\tmotivos.push('Tipo de embalagem ausente');\n\t}\n\n\tif (!material) {\n\t\tmotivos.push('Material ausente');\n\t}\n\n\tif (!dimensoes) {\n\t\tmotivos.push('Dimensões ausentes');\n\t}\n\n\tif (!quantidade || quantidade < quantidadeMinima) {\n\t\tmotivos.push(\n\t\t\t`Quantidade inválida ou inferior ao mínimo de ${quantidadeMinima}`\n\t\t);\n\t}\n\n\tif (!numeroCores || numeroCores < 1) {\n\t\tmotivos.push('Número de cores inválido');\n\t}\n\n\tif (!prazoDias || prazoDias < 1) {\n\t\tmotivos.push('Prazo inválido');\n\t}\n\n\tconst area = calcularArea(dimensoes);\n\n\tif (dimensoes && area === null) {\n\t\tmotivos.push('Formato das dimensões inválido');\n\t}\n\n\tif (motivos.length > 0) {\n\t\treturn resultadoRevisao(pedido, motivos);\n\t}\n\n\t// ------------------------------------------------------\n\t// BUSCAR REGRA DE PREÇO\n\t// ------------------------------------------------------\n\n\tconst regraPreco = regrasPrecoBase.find(regra => {\n\t\tconst mesmoTipo =\n\t\t\tnormalizar(regra.tipo_embalagem) ===\n\t\t\tnormalizar(tipoEmbalagem);\n\n\t\tconst mesmoMaterial =\n\t\t\tnormalizar(regra.material) === normalizar(material);\n\n\t\tconst dentroDaArea =\n\t\t\tarea >= numero(regra.area_min_cm2) &&\n\t\t\tarea <= numero(regra.area_max_cm2, 999999);\n\n\t\tconst dentroDaQuantidade =\n\t\t\tquantidade >= numero(regra.quantidade_min) &&\n\t\t\tquantidade <= numero(regra.quantidade_max, 999999);\n\n\t\treturn (\n\t\t\tmesmoTipo &&\n\t\t\tmesmoMaterial &&\n\t\t\tdentroDaArea &&\n\t\t\tdentroDaQuantidade\n\t\t);\n\t});\n\n\tif (!regraPreco) {\n\t\treturn resultadoRevisao(pedido, [\n\t\t\t`Regra de preço não encontrada para ${tipoEmbalagem}, ${material}, área ${area} cm² e quantidade ${quantidade}`,\n\t\t]);\n\t}\n\n\t// ------------------------------------------------------\n\t// ACABAMENTO\n\t// ------------------------------------------------------\n\n\tconst acabamentosEncontrados = regrasAcabamento.filter(regra => {\n\t\tconst termo = normalizar(regra.termo_observacao);\n\n\t\treturn (\n\t\t\ttermo &&\n\t\t\tnormalizar(observacoes).includes(termo)\n\t\t);\n\t});\n\n\tconst adicionalAcabamentoUnitario =\n\t\tacabamentosEncontrados.reduce(\n\t\t\t(total, regra) =>\n\t\t\t\ttotal +\n\t\t\t\tnumero(regra.adicional_acabamento_unitario),\n\t\t\t0\n\t\t);\n\n\t// ------------------------------------------------------\n\t// URGÊNCIA\n\t// ------------------------------------------------------\n\n\tconst regraUrgencia = regrasUrgencia.find(\n\t\tregra => prazoDias <= numero(regra.prazo_max_dias, 999999)\n\t);\n\n\tconst percentualUrgencia = regraUrgencia\n\t? percentual(regraUrgencia.percentual_urgencia)\n\t: 0;\n\n\t// ------------------------------------------------------\n\t// CÁLCULOS\n\t// ------------------------------------------------------\n\n\tconst precoBaseUnitario = numero(\n\t\tregraPreco.preco_base_unitario\n\t);\n\n\tconst adicionalCorExtraTabela = numero(\n\t\tregraPreco.adicional_cor_extra_unitario\n\t);\n\n\tconst quantidadeCoresExtras = Math.max(numeroCores - 1, 0);\n\n\tconst adicionalCoresUnitario =\n\t\tquantidadeCoresExtras * adicionalCorExtraTabela;\n\n\tconst setup = numero(regraPreco.setup_pedido);\n\n\tconst valorUnitario =\n\t\tprecoBaseUnitario +\n\t\tadicionalCoresUnitario +\n\t\tadicionalAcabamentoUnitario;\n\n\tconst subtotal = arredondar(\n\t\tvalorUnitario * quantidade + setup\n\t);\n\n\tconst valorTotal = arredondar(\n\t\tsubtotal * (1 + percentualUrgencia)\n\t);\n\n\tconst validade = new Date();\n\tvalidade.setDate(validade.getDate() + validadeDias);\n\n\treturn {\n\t\tjson: {\n\t\t\tid_orcamento: idSolicitacao.replace(/^AQ-/i, 'ORC-'),\n\t\t\tid_solicitacao: idSolicitacao,\n\t\t\tdata_processamento: new Date().toISOString(),\n\t\t\tnome_empresa: nomeEmpresa,\n\t\t\ttipo_embalagem: tipoEmbalagem,\n\t\t\tmaterial,\n\t\t\tdimensoes,\n\t\t\tquantidade,\n\t\t\tnumero_cores: numeroCores,\n\t\t\tprazo_dias: prazoDias,\n\n\t\t\tcodigo_regra_preco: texto(regraPreco.codigo_regra),\n\t\t\tpreco_base_unitario: arredondar(precoBaseUnitario),\n\t\t\tadicional_cores_unitario: arredondar(\n\t\t\t\tadicionalCoresUnitario\n\t\t\t),\n\t\t\tadicional_acabamento_unitario: arredondar(\n\t\t\t\tadicionalAcabamentoUnitario\n\t\t\t),\n\t\t\tsetup: arredondar(setup),\n\t\t\tpercentual_urgencia: percentualUrgencia,\n\t\t\tsubtotal,\n\t\t\tvalor_total: valorTotal,\n\n\t\t\tstatus: 'CALCULADO',\n\t\t\tmotivo_revisao: '',\n\t\t\tvalidade_ate: dataFormatoISO(validade),\n\t\t\tlink_pdf: '',\n\t\t},\n\t};\n});"
      },
      "type": "n8n-nodes-base.code",
